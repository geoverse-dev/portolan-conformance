{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/geoverse-dev/portolan-conformance/external-catalogs/schema.json",
  "title": "Portolan external catalog observation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "catalogs"
  ],
  "properties": {
    "manifest_version": {
      "const": "1"
    },
    "catalogs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "mutable",
          "operations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "mutable": {
            "type": "boolean"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "document",
                "inspect",
                "links",
                "assets"
              ]
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
